NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://finvault_user:finvault_pass@localhost:5432/finvault

# MongoDB
MONGODB_URI=mongodb://finvault_user:finvault_pass@localhost:27017/finvault_audit?authSource=admin

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=finvault-consumers

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access-secret
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
